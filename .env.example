# AURA STUDIOS - environment settings (copy to .env)

# Required for production: a long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Server port
PORT=5000

# Set to 1 only while developing (auto-reload + debugger)
FLASK_DEBUG=0

# Optional: Supabase cloud database. Leave blank to use the built-in SQLite database.
SUPABASE_URL=
SUPABASE_KEY=
